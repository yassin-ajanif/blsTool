# IPRoyal residential proxy (Fanika) — copy to .env and fill in
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# Sticky session lifetime in seconds (high = stay on same IP until you rotate)
PROXY_LIFETIME=3600

# Optional country code (e.g. ma, es). Leave empty if already in PROXY_PASSWORD.
PROXY_COUNTRY=
