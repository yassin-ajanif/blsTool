# IPRoyal residential proxy (Fanika) — copy to .env and fill in
PROXY_HOST=geo.iproyal.com
PROXY_PORT=11231
PROXY_USERNAME=your_proxy_username

# Password bases — NO _session- / _lifetime- (Fanika adds those on each rotate)
PROXY_PASSWORD_RANDOM=your_token_country-ma
PROXY_PASSWORD_TETOUAN=your_token_country-ma_city-tetouan
PROXY_PASSWORD_TANGIER=your_token_country-ma_city-tangier
PROXY_PASSWORD_CASABLANCA=your_token_country-ma_city-casablanca

# Fallback if a city key is missing
PROXY_PASSWORD=your_token_country-ma_city-tetouan

PROXY_LIFETIME=30m

PROXY_ROTATE_MAX_ATTEMPTS=8
PROXY_ROTATE_RETRY_MS=800
