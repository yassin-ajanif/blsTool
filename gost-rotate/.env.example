# IPRoyal residential (gost upstream) — copy to .env
PROXY_HOST=geo.iproyal.com
PROXY_PORT=11231
PROXY_USERNAME=your_proxy_username
# Base password; _session- / _lifetime- are added by the helper
PROXY_PASSWORD=your_password_country-ma_city-tetouan
PROXY_LIFETIME=30m

# Local gost listen (FoxyProxy points here)
GOST_LISTEN=127.0.0.1:8888

# Fanika calls this trigger
HELPER_HOST=127.0.0.1
HELPER_PORT=9999
