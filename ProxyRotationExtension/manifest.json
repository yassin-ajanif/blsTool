{
  "manifest_version": 3,
  "name": "Proxy Rotation Lab",
  "version": "0.1.0",
  "description": "Step 1 — Chrome proxy + silent IPRoyal auth + icanhazip",
  "action": {
    "default_title": "Proxy Rotation Lab",
    "default_popup": "popup.html"
  },
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://ipv4.icanhazip.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
