{
  "manifest_version": 3,
  "name": "Proxy Rotation Lab",
  "version": "0.1.1",
  "description": "Chrome proxy + IPRoyal rotate + center timer overlay",
  "action": {
    "default_title": "Proxy Rotation Lab",
    "default_popup": "popup.html"
  },
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://ipv4.icanhazip.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["center-timer.js"],
      "run_at": "document_idle"
    }
  ]
}
